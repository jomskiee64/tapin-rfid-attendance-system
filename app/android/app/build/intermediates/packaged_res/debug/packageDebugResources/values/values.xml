<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <color name="tapin_gold">#D4AF37</color>
    <color name="tapin_maroon">#800020</color>
    <color name="tapin_maroon_dark">#2C0A12</color>
    <color name="tapin_navy">#002855</color>
    <color name="tapin_teal">#00C2B2</color>
    <color name="white">#FFFFFF</color>
    <string name="app_name">TapIn</string>
    <string name="splash_subtitle">RFID Attendance System</string>
    <style name="Theme.TapIn" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:statusBarColor">@color/tapin_maroon_dark</item>
        <item name="android:navigationBarColor">@color/tapin_maroon_dark</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="android:windowBackground">@color/tapin_maroon_dark</item>
    </style>
    <style name="Theme.TapIn.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_tapin_logo</item>
        <item name="windowSplashScreenBackground">@color/tapin_maroon_dark</item>
        <item name="postSplashScreenTheme">@style/Theme.TapIn</item>
    </style>
</resources>